# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# Datasets — downloaded by the code, never committed
data_cache/
data/
datasets/

# Model weights (19 GB across 223 runs; far past GitHub's 100 MB file limit).
# Every run is reproducible from its config: see runs/<name>/result.json.
*.pt
*.pth
*.ckpt
*.h5
*.hdf5

# Per-run sample tensors — regenerate with the run, or read them from
# web/data.json which carries the rendered PNGs.
*.npz
*.npy

# Regenerable build products
reports/sample_cache/
reports/dashboard.html
web/dashboard.html
reports/tests_cache.json

# Run outputs: keep the RESULTS and provenance logs, drop everything else.
runs/*
!runs/*/
runs/*/*
!runs/*/result.json
!runs/*.log

# Secrets
.env
*.key
*.pem

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
